{
  "mcpServers": {
    "featurehub": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/dist/index.js"],
      "env": {
        "FEATUREHUB_URL": "${user_config.featurehub_url}",
        "FEATUREHUB_ADMIN_TOKEN": "${user_config.admin_token}",
        "FEATUREHUB_EMAIL": "${user_config.email}",
        "FEATUREHUB_PASSWORD": "${user_config.password}",
        "FEATUREHUB_WRITE_ACCESS": "${user_config.write_access}"
      }
    }
  }
}
